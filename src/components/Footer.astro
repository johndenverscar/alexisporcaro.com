---
import { SITE, NAV } from "../consts";
import InstagramIcon from "./InstagramIcon.astro";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-100 bg-ink-100/40">
  <div
    class="mx-auto grid max-w-6xl gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-3 lg:px-8"
  >
    <div>
      <p class="font-serif text-2xl text-ink-900">{SITE.name}</p>
      <p class="mt-1 text-sm tracking-wide text-brass-600">{SITE.role}</p>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-500">
        Performing artist and teacher. For booking, lessons, or general
        inquiries, please reach out.
      </p>
    </div>

    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-ink-500">Explore</p>
      <ul class="mt-4 space-y-2 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-ink-700 transition-colors hover:text-brass-600"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-ink-500">Connect</p>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-4 block text-sm text-ink-700 transition-colors hover:text-brass-600"
        >{SITE.email}</a
      >
      <a
        href={SITE.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-2 text-sm text-ink-700 transition-colors hover:text-brass-600"
      >
        <InstagramIcon class="h-4 w-4" />
        {SITE.instagramHandle}
      </a>
    </div>
  </div>

  <div class="border-t border-ink-100">
    <p
      class="mx-auto max-w-6xl px-6 py-6 text-xs text-ink-300 lg:px-8"
    >
      © {year} {SITE.name}. All rights reserved.
    </p>
  </div>
</footer>
