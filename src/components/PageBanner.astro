---
import { urlFor } from "../lib/sanity";

interface Props {
  title: string;
  eyebrow?: string;
  image?: unknown;
}
const { title, eyebrow, image } = Astro.props;
const src = image
  ? urlFor(image).width(2000).height(900).fit("crop").auto("format").url()
  : null;
---

<section class="relative h-[44vh] min-h-[300px] w-full overflow-hidden">
  {
    src && (
      <img
        src={src}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
        fetchpriority="high"
      />
    )
  }
  <div class="absolute inset-0 bg-ink-900/55"></div>
  <div
    class="relative z-10 mx-auto flex h-full max-w-6xl flex-col justify-end px-6 pb-12 lg:px-8"
  >
    {
      eyebrow && (
        <p class="mb-3 text-sm uppercase tracking-[0.3em] text-brass-400">
          {eyebrow}
        </p>
      )
    }
    <h1 class="font-serif text-5xl text-ink-50 sm:text-6xl">{title}</h1>
  </div>
</section>
