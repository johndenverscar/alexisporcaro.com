---
import { SITE, NAV } from "../consts";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-ink-100 bg-ink-50/85 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 lg:px-8"
  >
    <a
      href="/"
      class="font-serif text-xl tracking-tight text-ink-900 transition-opacity hover:opacity-70"
    >
      {SITE.name}
      <span class="ml-1 hidden text-sm text-brass-600 sm:inline"
        >· {SITE.role}</span
      >
    </a>

    <div class="flex items-center gap-6">
      <ul class="hidden items-center gap-7 text-sm md:flex">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "relative tracking-wide transition-colors hover:text-brass-600",
                  isActive(item.href)
                    ? "text-brass-600"
                    : "text-ink-700",
                ]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        class="text-ink-700 transition-colors hover:text-brass-600 md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-ink-100 bg-ink-50 md:hidden"
  >
    <ul class="mx-auto max-w-6xl px-6 py-2">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                "block py-2.5 text-sm tracking-wide",
                isActive(item.href) ? "text-brass-600" : "text-ink-700",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
