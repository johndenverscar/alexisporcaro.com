---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import { getAbout } from "../lib/queries";
import { urlFor } from "../lib/sanity";
import { toHTML } from "@portabletext/to-html";

const about = await getAbout();
const portraitSrc = about?.portrait
  ? urlFor(about.portrait).width(900).auto("format").url()
  : null;
const bioHtml = about?.bio
  ? toHTML(about.bio, {
      components: {
        marks: {
          strong: ({ children }) =>
            `<strong class="font-medium text-ink-900">${children}</strong>`,
        },
      },
    })
  : "";
---

<Layout title="About — Alexis Porcaro">
  <PageBanner
    title={about?.bannerTitle ?? "About"}
    eyebrow={about?.bannerEyebrow}
    image={about?.bannerImage}
  />

  <section class="py-20">
    <div
      class="mx-auto grid max-w-6xl gap-14 px-6 md:grid-cols-[1.4fr_1fr] lg:gap-20 lg:px-8"
    >
      <!-- Bio -->
      <div class="reveal">
        <h2 class="text-3xl text-ink-900">Biography</h2>
        <div
          class="mt-5 space-y-5 text-lg font-light leading-relaxed text-ink-700"
          set:html={bioHtml}
        />
      </div>

      <!-- Sidebar -->
      <aside class="reveal space-y-10">
        {
          portraitSrc && (
            <img
              src={portraitSrc}
              alt="Alexis Porcaro"
              class="aspect-[4/5] w-full rounded-sm object-cover shadow-lg"
              loading="lazy"
            />
          )
        }
        {
          about?.facts?.length > 0 && (
            <dl class="divide-y divide-ink-100 border-y border-ink-100">
              {about.facts.map((f: { label: string; value: string }) => (
                <div class="flex items-baseline justify-between py-3">
                  <dt class="text-xs uppercase tracking-[0.2em] text-ink-500">
                    {f.label}
                  </dt>
                  <dd class="text-right text-sm text-ink-900">{f.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </aside>
    </div>
  </section>

  {
    about?.repertoire?.length > 0 && (
      <section class="bg-ink-100/40 py-20">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <p class="text-xs uppercase tracking-[0.3em] text-brass-600">
            Selected Repertoire
          </p>
          <h2 class="mt-3 text-4xl text-ink-900">
            {about.repertoireHeading ?? "Concertos & solo works"}
          </h2>
          <ul class="mt-10 grid gap-x-12 gap-y-4 text-lg font-light text-ink-700 sm:grid-cols-2">
            {about.repertoire.map((piece: string) => (
              <li class="flex items-baseline gap-3 border-b border-ink-100 pb-4">
                <span class="text-brass-500" aria-hidden="true">
                  ♪
                </span>
                {piece}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Layout>
