---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import { getLessons } from "../lib/queries";
import { urlFor } from "../lib/sanity";

const lessons = await getLessons();
const studioSrc = lessons?.studioImage
  ? urlFor(lessons.studioImage).width(900).auto("format").url()
  : null;
---

<Layout title="Private Lessons — Alexis Porcaro">
  <PageBanner
    title={lessons?.bannerTitle ?? "Private Lessons"}
    eyebrow={lessons?.bannerEyebrow ?? "Studio"}
    image={lessons?.bannerImage}
  />

  <section class="py-20">
    <div class="mx-auto max-w-3xl px-6 text-center lg:px-8">
      {
        lessons?.introHeading && (
          <h2 class="text-4xl text-ink-900 sm:text-5xl">
            {lessons.introHeading}
          </h2>
        )
      }
      {
        lessons?.introBody && (
          <p class="mt-6 text-lg font-light leading-relaxed text-ink-700">
            {lessons.introBody}
          </p>
        )
      }
    </div>
  </section>

  {
    lessons?.offerings?.length > 0 && (
      <section class="pb-8">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <div class="grid gap-6 md:grid-cols-3">
            {lessons.offerings.map(
              (o: { title: string; body: string }) => (
                <div class="reveal rounded-sm border border-ink-100 bg-white/40 p-8">
                  <h3 class="font-serif text-2xl text-ink-900">{o.title}</h3>
                  <p class="mt-3 font-light leading-relaxed text-ink-700">
                    {o.body}
                  </p>
                </div>
              ),
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="py-16">
    <div
      class="mx-auto grid max-w-6xl items-center gap-12 px-6 md:grid-cols-2 lg:gap-20 lg:px-8"
    >
      {
        studioSrc && (
          <img
            src={studioSrc}
            alt="In the studio"
            class="reveal aspect-[4/5] w-full rounded-sm object-cover shadow-lg"
            loading="lazy"
          />
        )
      }
      <div class="reveal">
        <p class="text-xs uppercase tracking-[0.3em] text-brass-600">
          What to expect
        </p>
        <h2 class="mt-3 text-4xl text-ink-900">The studio approach</h2>
        {
          lessons?.expectations?.length > 0 && (
            <ul class="mt-8 space-y-4">
              {lessons.expectations.map((item: string) => (
                <li class="flex items-start gap-3 text-lg font-light text-ink-700">
                  <span class="mt-1 text-brass-500" aria-hidden="true">
                    ✦
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          )
        }
        {
          lessons?.tuitionHeadline && (
            <div class="mt-10 rounded-sm bg-ink-900 p-8 text-ink-50">
              {lessons.tuitionLabel && (
                <p class="text-sm uppercase tracking-[0.2em] text-brass-400">
                  {lessons.tuitionLabel}
                </p>
              )}
              <p class="mt-2 font-serif text-3xl">{lessons.tuitionHeadline}</p>
              {lessons.tuitionBody && (
                <p class="mt-2 text-sm font-light text-ink-100">
                  {lessons.tuitionBody}
                </p>
              )}
              {lessons.tuitionButtonLabel && (
                <a
                  href={lessons.tuitionButtonHref || "/contact"}
                  class="mt-6 inline-block rounded-full bg-brass-500 px-6 py-3 text-sm font-medium text-ink-900 transition-colors hover:bg-brass-400"
                >
                  {lessons.tuitionButtonLabel}
                </a>
              )}
            </div>
          )
        }
      </div>
    </div>
  </section>
</Layout>
