---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import { getEventsPage, getEvents } from "../lib/queries";

const events = (await getEvents()) ?? [];

type EventDoc = {
  _id: string;
  date: string;
  title: string;
  detail?: string;
  city?: string;
  ticketUrl?: string;
};

const today = new Date().toISOString().slice(0, 10);
const upcoming = (events as EventDoc[])
  .filter((e) => e.date >= today)
  .sort((a, b) => a.date.localeCompare(b.date));
const past = (events as EventDoc[])
  .filter((e) => e.date < today)
  .sort((a, b) => b.date.localeCompare(a.date));

// Reuse contact banner image for events page (or change to a dedicated one)
const fmt = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en-US", {
    weekday: "short",
    month: "short",
    day: "numeric",
    year: "numeric",
  });

const page = await getEventsPage();
---

<Layout title="Events — Alexis Porcaro">
  <PageBanner
    title={page?.bannerTitle ?? "Events"}
    eyebrow={page?.bannerEyebrow ?? "Calendar"}
    image={page?.bannerImage}
  />

  <section class="py-20">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <h2 class="text-3xl text-ink-900">Upcoming</h2>
      {
        upcoming.length === 0 ? (
          <p class="mt-6 text-ink-500">No upcoming dates posted yet — check back soon.</p>
        ) : (
          <ul class="mt-8 divide-y divide-ink-100 border-y border-ink-100">
            {upcoming.map((e) => (
              <li class="reveal grid gap-3 py-7 sm:grid-cols-[150px_1fr_auto] sm:items-center sm:gap-6">
                <time class="text-sm font-medium uppercase tracking-wide text-brass-600">
                  {fmt(e.date)}
                </time>
                <div>
                  <h3 class="font-serif text-2xl text-ink-900">{e.title}</h3>
                  {e.detail && <p class="mt-1 text-ink-700">{e.detail}</p>}
                  {e.city && <p class="mt-1 text-sm text-ink-500">{e.city}</p>}
                </div>
                {e.ticketUrl && (
                  <a
                    href={e.ticketUrl}
                    class="justify-self-start rounded-full border border-ink-900 px-5 py-2 text-sm font-medium text-ink-900 transition-colors hover:bg-ink-900 hover:text-ink-50 sm:justify-self-end"
                  >
                    Tickets
                  </a>
                )}
              </li>
            ))}
          </ul>
        )
      }

      {
        past.length > 0 && (
          <>
            <h2 class="mt-20 text-3xl text-ink-900">Past Performances</h2>
            <ul class="mt-8 divide-y divide-ink-100 border-y border-ink-100">
              {past.map((e) => (
                <li class="grid gap-1 py-5 sm:grid-cols-[150px_1fr] sm:gap-6">
                  <time class="text-sm uppercase tracking-wide text-ink-500">
                    {fmt(e.date)}
                  </time>
                  <div>
                    <h3 class="text-lg text-ink-900">{e.title}</h3>
                    <p class="text-sm text-ink-500">
                      {[e.detail, e.city].filter(Boolean).join(" · ")}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>
</Layout>
