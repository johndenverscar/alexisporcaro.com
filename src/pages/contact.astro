---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import { SITE_FALLBACK } from "../consts";
import { getContact, getSite } from "../lib/queries";

const page = await getContact();
const site = (await getSite()) ?? SITE_FALLBACK;

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
---

<Layout title="Contact — Alexis Porcaro">
  <PageBanner
    title={page?.bannerTitle ?? "Contact"}
    eyebrow={page?.bannerEyebrow ?? "Get in Touch"}
    image={page?.bannerImage}
  />

  <section class="py-20">
    <div
      class="mx-auto grid max-w-6xl gap-14 px-6 md:grid-cols-[1fr_1.2fr] lg:gap-20 lg:px-8"
    >
      <!-- Details -->
      <div class="reveal">
        {
          page?.introHeading && (
            <h2 class="text-3xl text-ink-900">{page.introHeading}</h2>
          )
        }
        {
          page?.introBody && (
            <p class="mt-4 text-lg font-light leading-relaxed text-ink-700">
              {page.introBody}
            </p>
          )
        }

        <div class="mt-10 space-y-6">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-ink-500">Email</p>
            <a
              href={`mailto:${site.email}`}
              class="mt-1 block text-lg text-ink-900 transition-colors hover:text-brass-600"
              >{site.email}</a
            >
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="reveal">
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="post"
          class="space-y-5 rounded-sm border border-ink-100 bg-white/50 p-8"
        >
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="from_name" value="alexisporcaro.com" />
          <input
            type="hidden"
            name="subject"
            value="New inquiry from alexisporcaro.com"
          />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="text-xs uppercase tracking-[0.2em] text-ink-500"
                >Name</span
              >
              <input
                type="text"
                name="name"
                required
                class="mt-2 w-full rounded-sm border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none transition focus:border-brass-500"
              />
            </label>
            <label class="block">
              <span class="text-xs uppercase tracking-[0.2em] text-ink-500"
                >Email</span
              >
              <input
                type="email"
                name="email"
                required
                class="mt-2 w-full rounded-sm border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none transition focus:border-brass-500"
              />
            </label>
          </div>

          <label class="block">
            <span class="text-xs uppercase tracking-[0.2em] text-ink-500"
              >Inquiry</span
            >
            <select
              name="inquiry_type"
              class="mt-2 w-full rounded-sm border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none transition focus:border-brass-500"
            >
              <option>Booking / Performance</option>
              <option>Private Lessons</option>
              <option>Press / Media</option>
              <option>Other</option>
            </select>
          </label>

          <label class="block">
            <span class="text-xs uppercase tracking-[0.2em] text-ink-500"
              >Message</span
            >
            <textarea
              name="message"
              rows="5"
              required
              class="mt-2 w-full rounded-sm border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none transition focus:border-brass-500"
            ></textarea>
          </label>

          <button
            id="contact-submit"
            type="submit"
            class="w-full rounded-full bg-ink-900 px-8 py-3.5 text-sm font-medium tracking-wide text-ink-50 transition-colors hover:bg-ink-700 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send Message
          </button>
          <p
            id="contact-status"
            class="hidden text-center text-sm"
            role="status"
            aria-live="polite"
          >
          </p>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("contact-status");
    const button = document.getElementById("contact-submit") as HTMLButtonElement | null;

    function setStatus(message: string, ok: boolean) {
      if (!status) return;
      status.textContent = message;
      status.classList.remove("hidden", "text-brass-600", "text-red-600");
      status.classList.add(ok ? "text-brass-600" : "text-red-600");
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!button) return;

      const data = Object.fromEntries(new FormData(form));
      if (!data.access_key) {
        setStatus("Form isn’t configured yet. Please email directly.", false);
        return;
      }

      button.disabled = true;
      const original = button.textContent;
      button.textContent = "Sending…";

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (res.ok && result.success) {
          form.reset();
          setStatus("Thanks — your message has been sent.", true);
        } else {
          setStatus(result.message || "Something went wrong. Please email directly.", false);
        }
      } catch {
        setStatus("Network error. Please email directly.", false);
      } finally {
        button.disabled = false;
        button.textContent = original;
      }
    });
  </script>
</Layout>
