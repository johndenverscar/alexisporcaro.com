---
import Layout from "../layouts/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import { getAudio, getMediaPage, getVideos } from "../lib/queries";
import { urlFor } from "../lib/sanity";
import { audioEmbed, videoEmbed } from "../lib/embed";

const page = await getMediaPage();
const videos = ((await getVideos()) ?? []) as Array<{
  _id: string;
  title: string;
  detail?: string;
  embedUrl: string;
  customPoster?: unknown;
  isFeatured?: boolean;
}>;
const audio = ((await getAudio()) ?? []) as Array<{
  _id: string;
  title: string;
  detail?: string;
  embedUrl: string;
}>;

const featured = videos.find((v) => v.isFeatured) ?? videos[0] ?? null;
const restVideos = videos.filter((v) => v._id !== featured?._id);

const posterOrThumb = (
  embedUrl: string,
  custom: unknown,
  width = 1280,
): string | null => {
  if (custom) return urlFor(custom).width(width).auto("format").url();
  const yt = embedUrl.match(
    /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})/,
  );
  if (yt) return `https://i.ytimg.com/vi/${yt[1]}/maxresdefault.jpg`;
  return null;
};
---

<Layout
  title="Media — Alexis Porcaro"
  description="Video performances and audio recordings by oboist Alexis Porcaro."
>
  <PageBanner
    title={page?.bannerTitle ?? "Media"}
    eyebrow={page?.bannerEyebrow ?? "Watch & Listen"}
    image={page?.bannerImage}
  />

  <!-- VIDEO -->
  {
    videos.length > 0 && (
      <section class="py-20">
        <div class="mx-auto max-w-6xl px-6 lg:px-8">
          <p class="text-xs uppercase tracking-[0.3em] text-brass-600">Video</p>
          <h2 class="mt-3 text-4xl text-ink-900">Performances</h2>

          {featured && (
            <figure class="reveal mt-10">
              <div class="aspect-video w-full overflow-hidden rounded-sm bg-ink-900">
                <iframe
                  src={videoEmbed(featured.embedUrl) ?? featured.embedUrl}
                  title={featured.title}
                  loading="lazy"
                  class="h-full w-full"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                />
              </div>
              <figcaption class="mt-4">
                <p class="font-serif text-2xl text-ink-900">{featured.title}</p>
                {featured.detail && (
                  <p class="mt-1 text-sm text-ink-500">{featured.detail}</p>
                )}
              </figcaption>
            </figure>
          )}

          {restVideos.length > 0 && (
            <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
              {restVideos.map((v) => {
                const embed = videoEmbed(v.embedUrl) ?? v.embedUrl;
                const poster = posterOrThumb(v.embedUrl, v.customPoster, 800);
                return (
                  <figure class="reveal">
                    <div class="aspect-video w-full overflow-hidden rounded-sm bg-ink-900">
                      <iframe
                        src={embed}
                        title={v.title}
                        loading="lazy"
                        class="h-full w-full"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                        style={poster ? `background-image:url(${poster});background-size:cover;` : ""}
                      />
                    </div>
                    <figcaption class="mt-3">
                      <p class="text-ink-900">{v.title}</p>
                      {v.detail && (
                        <p class="mt-0.5 text-sm text-ink-500">{v.detail}</p>
                      )}
                    </figcaption>
                  </figure>
                );
              })}
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- AUDIO -->
  {
    audio.length > 0 && (
      <section class="bg-ink-900 py-20 text-ink-50">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
          <p class="text-xs uppercase tracking-[0.3em] text-brass-400">Audio</p>
          <h2 class="mt-3 text-4xl">Recordings</h2>
          <ul class="mt-10 space-y-6">
            {audio.map((a) => {
              const src = audioEmbed(a.embedUrl);
              return (
                <li class="reveal">
                  <p class="font-serif text-xl">{a.title}</p>
                  {a.detail && (
                    <p class="mt-0.5 text-sm text-ink-300">{a.detail}</p>
                  )}
                  {src && (
                    <iframe
                      src={src}
                      title={a.title}
                      loading="lazy"
                      class="mt-3 w-full"
                      height="80"
                      allow="autoplay; clipboard-write; encrypted-media"
                    />
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }
</Layout>
